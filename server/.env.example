# Copy this file to .env and adjust as needed

# Your MongoDB connection string.
# For the local Compass connection shown in your screenshot (Localhost > kirti_garments):
MONGODB_URI=mongodb://127.0.0.1:27017/kirti_garments

# If you use MongoDB Atlas instead, it looks like:
# MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/kirti_garments

PORT=5000

# Comma-separated list of origins allowed to call this API
CORS_ORIGIN=http://localhost:5173
